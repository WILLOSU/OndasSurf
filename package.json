{
  "name": "typscript-api",
  "version": "1.0.0",
  "private": true,
  "description": "Typescript Node.js API",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:local": "ts-node-dev --files src/index.ts | pino-pretty",
    "test": "jest",
    "test:functional": "jest --projects ./test --runInBand",
    "lint": "eslint ./src ./test --ext .ts",
    "style:check": "prettier --check src/**/*.ts test/**/*.ts",
    "style:fix": "prettier --write src/**/*.ts test/**/*.ts",
    "test:unit": "jest",
    "lint:fix": "eslint ./src ./test --ext .ts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WILLOSU/OndasSurf.git"
  },
  "keywords": [
    "nodejs",
    "typscript",
    "api"
  ],
  "author": "William Mota",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/WILLOSU/OndasSurf/issues"
  },
  "homepage": "https://github.com/WILLOSU/OndasSurf#readme",
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/config": "^3.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-pino-logger": "^4.0.6",
    "@types/http-status-codes": "^1.2.0",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/lodash": "^4.17.23",
    "@types/module-alias": "^2.0.4",
    "@types/mongoose": "^5.11.97",
    "@types/multer": "^2.0.0",
    "@types/nock": "^11.1.0",
    "@types/node": "^24.7.2",
    "@types/pino": "^7.0.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "8",
    "jest": "^30.2.0",
    "nock": "^14.0.10",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@overnightjs/core": "^1.7.6",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.0",
    "config": "^4.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-openapi-validator": "^5.6.2",
    "http-status-code": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.23",
    "module-alias": "^2.2.3",
    "mongoose": "^9.0.2",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "react-leaflet": "^5.0.0",
    "swagger-ui-express": "^5.0.1"
  }
